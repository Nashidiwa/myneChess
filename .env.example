# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/online_chess?schema=public"

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-for-development-change-in-production-min-32-chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=super-secret-refresh-key-for-development-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Logging
LOG_LEVEL=info

# Default Admin User (For initial seed or development)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@onlinechess.local
ADMIN_PASSWORD=AdminSecurePass123!

# Client Environment (Vite)
VITE_API_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000

# Google OAuth
GOOGLE_CLIENT_ID=681861375668-f0ri0q69lv7cqdhh3s250aa7cd5ed4cq.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=681861375668-f0ri0q69lv7cqdhh3s250aa7cd5ed4cq.apps.googleusercontent.com

# Email Verification (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Online Chess <no-reply@onlinechess.local>"
CLIENT_APP_URL=http://localhost:5173
